# Auto-detect text files and normalize line endings to LF in the repo.
# Working-copy line endings depend on each user's core.autocrlf setting:
#   Windows: git config --global core.autocrlf true   (LF in repo, CRLF in working copy)
#   Mac:     git config --global core.autocrlf input  (LF everywhere)
* text=auto eol=lf

# ---- Source code (force LF, works on both platforms) ----
*.js       text eol=lf
*.jsx      text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.json     text eol=lf
*.html     text eol=lf
*.htm      text eol=lf
*.css      text eol=lf
*.scss     text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.xml      text eol=lf
*.svg      text eol=lf

# ---- Shell scripts MUST be LF or they fail to execute on Mac/Linux ----
*.sh       text eol=lf
*.bash     text eol=lf
Makefile   text eol=lf
makefile   text eol=lf

# ---- Windows batch files must be CRLF ----
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# ---- iOS / Xcode files ----
*.swift          text eol=lf
*.m              text eol=lf
*.h              text eol=lf
*.plist          text eol=lf
*.storyboard     text eol=lf
*.xib            text eol=lf
*.pbxproj        text eol=lf merge=union
project.pbxproj  text eol=lf merge=union
*.xcconfig       text eol=lf

# ---- Android / Java / Kotlin files ----
*.java     text eol=lf
*.kt       text eol=lf
*.gradle   text eol=lf
*.pro      text eol=lf
gradlew    text eol=lf

# ---- Binary files (never modify, never diff) ----
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.icns     binary
*.webp     binary
*.pdf      binary
*.zip      binary
*.tar.gz   binary
*.jar      binary
*.aar      binary
*.so       binary
*.dylib    binary
*.keystore binary
*.jks      binary
*.p12      binary
*.mobileprovision binary
*.cer      binary
*.ttf      binary
*.otf      binary
*.woff     binary
*.woff2    binary
*.mp3      binary
*.mp4      binary
*.mov      binary

# ---- Lock files: keep as text but don't show diff noise ----
package-lock.json   text eol=lf -diff
yarn.lock           text eol=lf -diff
Podfile.lock        text eol=lf -diff
